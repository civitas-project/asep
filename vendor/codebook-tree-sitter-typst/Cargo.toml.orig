[package]
name = "codebook-tree-sitter-typst"
description = "typst grammar for the tree-sitter parsing library"
version = "0.12.2"
keywords = ["incremental", "parsing", "typst"]
categories = ["parsing", "text-editors"]
repository = "https://github.com/blopker/codebook-tree-sitter-typst"
edition = "2018"
license = "MIT"
authors = ["Codebook Contributors"]

build = "bindings/rust/build.rs"
include = [
  "bindings/rust/*",
  "grammar.js",
  "queries/*",
  "src/*",
]

[lib]
path = "bindings/rust/lib.rs"

[dependencies]
tree-sitter-language = "0.1"

[dev-dependencies]
tree-sitter = "0.25.10"

[build-dependencies]
cc = "1.0"
